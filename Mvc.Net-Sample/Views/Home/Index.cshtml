@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-5 border-0 rounded-4 text-center custom-home">
        <h1 class="display-4 text-primary fw-bold">🚀 Welcome, Rasee!</h1>
        <p class="lead text-muted">Welocme to the world of MVC Mameee!</p>

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Trials" class="btn btn-lg btn-primary mx-2 rounded-pill shadow-sm">📊 Overview</a>
            <a asp-controller="Home" asp-action="CreateTrials" class="btn btn-lg btn-success mx-2 rounded-pill shadow-sm">➕ Create New</a>
        </div>
    </div>
</div>



<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section HeaderScripts {

    @* <base href="@BaseUrl"> *@

    <environment names="Production,Development">
        <!-- Include all scripts in Staging and Production environments -->
        <link rel="stylesheet" asp-href-include="dist/styles.*.css" />
    </environment>

}

<div>
    <app-root></app-root>
</div>
@section Scripts {

    <environment names="Production,Development">

        <script asp-src-include="dist/runtime.*.js"></script>
        <script asp-src-include="dist/polyfills.*.js"></script>
        <script asp-src-include="dist/main.*.js"></script>

    </environment>
}