@{
    ViewData["Title"] = "Trials";
}
@model List<Trial>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">
            <h2 class="text-center text-primary fw-bold mb-4">🚀 Trials</h2>
            <hr />
            <h4 class="text-secondary text-center">Total Trials: <span class="fw-bold text-dark">$@ViewBag.Trials</span></h4>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trial in Model)
                        {
                            <tr class="table-light">
                                <td class="fw-bold">@trial.Id</td>
                                <td>@trial.Name</td>
                                <td>@trial.Description</td>
                                <td>
                                    <a asp-action="CreateTrials" asp-route-id="@trial.Id" class="btn btn-sm btn-warning text-white">✏️ Edit</a>
                                    <a asp-action="DeleteTrial" asp-route-id="@trial.Id" class="btn btn-sm btn-danger">🗑️ Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-center mt-3">
                <a asp-action="CreateTrials" class="btn btn-success px-4 py-2 fw-bold rounded-pill">➕ Add New Trial</a>
            </div>
            <a asp-action="Index"  class="btn btn-outline-secondary px-4 py-2 rounded-pill ms-2">🔙 Back</a>
        </div>
    </div>
</div>
