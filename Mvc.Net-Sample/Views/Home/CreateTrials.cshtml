@{
    ViewData["Title"] = "Create";
}
@model Mvc.Net_Sample.Models.Trial

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4 border-0 rounded-4 custom-bg">
        <div class="card-body">
            <h2 class="text-center text-primary fw-bold">🚀 Create a Trial</h2>

            <form asp-action="CreateTrialsForm" asp-controller="Home">
                <input hidden class="form-control" type="number" value="" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">📛 Name</label>
                    <input class="form-control rounded-3 shadow-sm" type="text" placeholder="Enter a name" asp-for="Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">📝 Description</label>
                    <textarea class="form-control rounded-3 shadow-sm" placeholder="Add a description" asp-for="Description" rows="3" required></textarea>
                </div>

                <div class="text-center">
                    <button class="btn btn-success px-4 py-2 fw-bold rounded-pill">✨ Create</button>
                    <a asp-action="Trials" asp-controller="Home" class="btn btn-outline-secondary px-4 py-2 rounded-pill ms-2">🔙 Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
